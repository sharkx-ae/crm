{
  "$schema": "https://design-tokens.org/tokens.json",
  "brand": "SHARKX",
  "tagline": "Marketing Built to Dominate",
  "website": "https://sharkx.ae",
  "version": "2.0.0",
  "updated": "2026-10-01",
  "brandBook": "references/brand-book-sharkx-2026.pdf",
  "officeTheme": "assets/office-theme.json",
  "artifactStarter": "assets/artifact-starter.html",
  "companyKnowledge": "assets/company.json",
  "companyKnowledgeDoc": "references/company-knowledge.md",
  "themePolicy": "light-canvas-for-office-deliverables-red-black-accents",
  "color": {
    "raw": {
      "red": { "hex": "#e70101", "rgb": [231, 1, 1], "role": "Primary brand, CTAs, chart series 1, cover bands" },
      "black": { "hex": "#1c0f0f", "rgb": [28, 15, 15], "role": "Secondary brand, body emphasis, chart series 2, corporate logo variant" },
      "white": { "hex": "#FFFFFF", "rgb": [255, 255, 255], "role": "Logo on red/dark, slide canvas, cards" },
      "redTint10": { "hex": "#fde6e6", "rgb": [253, 230, 230], "role": "Soft red wash, KPI highlight" },
      "redTint40": { "hex": "#f59999", "rgb": [245, 153, 153], "role": "Secondary fills (use sparingly)" },
      "redTint60": { "hex": "#f16767", "rgb": [241, 103, 103], "role": "Strong tint — decorative only" },
      "blackTint10": { "hex": "#e8e7e7", "rgb": [232, 231, 231], "role": "Borders, zebra alternate" },
      "blackTint40": { "hex": "#a49f9f", "rgb": [164, 159, 159], "role": "Muted UI, chart series 3" },
      "blackTint60": { "hex": "#776f6f", "rgb": [119, 111, 111], "role": "Captions on light bg if ≥14px" },
      "muted": { "hex": "#5c5656", "rgb": [92, 86, 86], "role": "Secondary body, captions" },
      "border": { "hex": "#e8e7e7", "rgb": [232, 231, 231], "role": "Cards, inputs, dividers" },
      "page": { "hex": "#fafafa", "rgb": [250, 250, 250], "role": "Page background" },
      "shell": { "hex": "#f5f5f5", "rgb": [245, 245, 245], "role": "Section wash" },
      "surface": { "hex": "#FFFFFF", "rgb": [255, 255, 255], "role": "Cards, modals" },
      "success": { "hex": "#0a7c42", "rgb": [10, 124, 66], "role": "Positive KPI dots/fills only — not small text on white" },
      "warning": { "hex": "#ff691e", "rgb": [255, 105, 30], "role": "Warnings" },
      "destructive": { "hex": "#b91c1c", "rgb": [185, 28, 28], "role": "Errors" }
    },
    "semantic": {
      "text": {
        "default": "#1c0f0f",
        "muted": "#5c5656",
        "faint": "#a49f9f",
        "onPrimary": "#FFFFFF",
        "onRed": "#FFFFFF",
        "link": "#e70101"
      },
      "surface": {
        "default": "#FFFFFF",
        "page": "#fafafa",
        "sunken": "#f5f5f5",
        "brandRed": "#e70101",
        "brandBlack": "#1c0f0f"
      },
      "border": {
        "default": "#e8e7e7",
        "strong": "rgba(28, 15, 15, 0.15)"
      },
      "brand": {
        "primary": "#e70101",
        "secondary": "#1c0f0f",
        "highlight": "#fde6e6"
      },
      "state": {
        "positive": "#0a7c42",
        "warning": "#ff691e",
        "negative": "#b91c1c",
        "focusRing": "#e70101"
      }
    }
  },
  "font": {
    "heading": {
      "family": "Sharp Sans",
      "fallback": "'Segoe UI', 'Helvetica Neue', Arial, sans-serif",
      "note": "Licensed font — add files under assets/fonts/ or install on system for Office"
    },
    "body": {
      "family": "Sharp Sans",
      "fallback": "'Segoe UI', 'Helvetica Neue', Arial, sans-serif"
    },
    "arabic": {
      "family": "GE Flow",
      "fallback": "'Segoe UI', 'Traditional Arabic', sans-serif"
    },
    "mono": {
      "family": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
      "fallback": "monospace"
    }
  },
  "type": {
    "scale": {
      "display": { "size": 40, "lineHeight": 1.08, "weight": 700, "font": "heading", "color": "#1c0f0f", "letterSpacing": "-0.02em" },
      "h1": { "size": 28, "lineHeight": 1.15, "weight": 700, "font": "heading", "color": "#1c0f0f" },
      "h2": { "size": 20, "lineHeight": 1.25, "weight": 500, "font": "heading", "color": "#1c0f0f" },
      "h3": { "size": 14, "lineHeight": 1.3, "weight": 500, "font": "body", "color": "#1c0f0f" },
      "body": { "size": 11, "lineHeight": 1.5, "weight": 300, "font": "body", "color": "#1c0f0f", "note": "Use 400 if Light unavailable in Office" },
      "bodyWeb": { "sizePx": 16, "lineHeight": 1.5, "weight": 300, "font": "body", "color": "#1c0f0f" },
      "small": { "size": 9, "lineHeight": 1.4, "weight": 400, "font": "body", "color": "#5c5656" },
      "footer": { "size": 8, "lineHeight": 1.4, "weight": 400, "font": "body", "color": "#5c5656" },
      "eyebrow": { "size": 11, "lineHeight": 1.2, "weight": 700, "font": "body", "letterSpacing": "0.08em", "textTransform": "uppercase", "color": "#e70101" }
    },
    "hierarchyRule": "Structure and readability over decoration — Bold H1, Medium H2, Light/Regular body"
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "base": 8 },
  "radius": { "none": 0, "sm": 4, "md": 10, "lg": 16, "xl": 20, "pill": 9999 },
  "elevation": {
    "sm": "0 1px 3px rgba(28, 15, 15, 0.08)",
    "md": "0 4px 12px rgba(28, 15, 15, 0.10)"
  },
  "logo": {
    "clearSpace": "Exclusion zone per brand book — no text, graphics, or edges inside minimum clear space around mark",
    "minHeightPx": 24,
    "minHeightPrintMm": 15,
    "wordmarkHeadlines": "SHARKX",
    "wordmarkBody": "SharkX",
    "urlOnly": "sharkx (lowercase) only when referencing sharkx.ae",
    "files": {
      "primaryRedBg": "assets/logos/logo-primary-red-bg.png",
      "redOnWhite": "assets/logos/logo-red-on-white.png",
      "redOnWhiteCompact": "assets/logos/logo-red-on-white-compact.png",
      "blackOnWhite": "assets/logos/logo-black-on-white.png",
      "blackOnWhiteCompact": "assets/logos/logo-black-on-white-compact.png",
      "whiteOnBlack": "assets/logos/logo-white-on-black.png",
      "marketingDescriptor": "assets/logos/logo-marketing-descriptor.png",
      "marketingDescriptorNote": "Interim wide wordmark — replace with official SHARKX Marketing lockup when available",
      "wordmarkWide240": "assets/logos/logo-red-wordmark-1800x240.png",
      "wordmarkWide400": "assets/logos/logo-red-wordmark-1800x400.png",
      "iconRedWhiteX": "assets/logos/icon-red-white-x.png",
      "iconWhiteBgRedX": "assets/logos/icon-white-bg-red-x.png",
      "iconBlackBgWhiteX": "assets/logos/icon-black-bg-white-x.png",
      "favicon": "assets/logos/favicon.png",
      "og": "assets/logos/og-image.png"
    }
  },
  "naming": {
    "incorrect": ["Sharkx", "sharkx (non-URL)", "Shark X", "Shark-X"],
    "arabic": "Supporting language only — logo never translated; SHARKX always Latin"
  }
}
