# apps/web (Next.js: UI + BFF). Copy to apps/web/.env.local for local development. Never put real values here.
# Staging/production values live in Railway variables of the `web` service. See docs/ENVIRONMENTS.md.
# Validated by apps/web/src/lib/env.ts: the server refuses to boot if a required variable is missing or invalid.
# The web app has NO database access; it calls the api service.

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development            # development | test | production
APP_ENV=local                   # local | staging | production
APP_URL=http://localhost:3000   # public URL of this app
LEADS_URL=                      # client lead-link host, e.g. https://leads.example.com (F10a; optional now)

# ---- Backend -------------------------------------------------------------
API_URL=http://localhost:4000   # server-side only; on Railway the api's private URL (http://api.railway.internal:<port>)

# ---- WhatsApp Embedded Signup (F3a; optional, unset = the connect card shows "Awaiting access") ----------
META_APP_ID=                    # the same Meta app id as in the api; public
META_ES_CONFIG_ID=              # Facebook Login for Business configuration id (Embedded Signup); public
META_GRAPH_VERSION=v27.0        # the same value as in the api

# ---- Security ------------------------------------------------------------
INTERNAL_API_TOKEN=             # 32+ random chars, the same value as in the api (openssl rand -base64 32); unique per environment
