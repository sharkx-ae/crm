# Production variables for the `web` Railway service (environment `production`).
# This file is a TEMPLATE: it is never read by the app. Set these in Railway → web → Variables → Raw Editor.
# Secrets stay empty here: keep them only in Railway.
# Not named `.env.production`: Next.js loads that name automatically on build and start.

NODE_ENV=production
APP_ENV=production              # never `local` on a deployed service
PORT=8080                       # must match the target port of the generated domain
APP_URL=https://web-production-94c552b4.up.railway.app   # this service's public URL, no trailing slash
API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8080       # the api's private address; its PORT is 8080
INTERNAL_API_TOKEN=             # 32+ chars, the SAME value as in api (a wrong value makes every api call answer 404)
