# apps/api (Fastify backend) and the worker (same code, separate service).
# Copy to apps/api/.env.local for local development. Never put real values here.
# Staging/production values live in Railway variables of the `api` and `worker` services. See docs/ENVIRONMENTS.md.
# Validated by apps/api/src/lib/env.ts: the process refuses to start if a required variable is missing or invalid.

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development            # development | test | production
APP_ENV=local                   # local | staging | production
LOG_LEVEL=debug                 # debug | info | warn | error
PORT=4000                       # api only; Railway injects its own
APP_URL=http://localhost:3000   # web app URL (email links); api only

# ---- Database ------------------------------------------------------------
DATABASE_URL=postgres://sharkx:sharkx@localhost:5433/sharkx
TEST_DATABASE_URL=postgres://sharkx:sharkx@localhost:5433/sharkx_test   # local + CI only; name must end in _test

# ---- Security ------------------------------------------------------------
INTERNAL_API_TOKEN=             # 32+ random characters, the same value in web and api (openssl rand -base64 32)
TOKEN_ENC_KEY=                  # base64 32 bytes for integration tokens (F5; optional now)

# ---- Demo data (local/staging only; never in production) ----------------
SEED_PASSWORD=                  # password of every user `pnpm db:seed` creates: 12+ chars, a letter and a digit

# ---- Email (required on staging/production) ------------------------------
RESEND_API_KEY=
EMAIL_FROM=                     # e.g. SHARKX CRM <no-reply@example.com>
ALERT_EMAIL=                    # inbox for connection problems and errors

# ---- Integrations (placeholders; each spec adds validation) ---------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_CAPI_TEST_EVENT_CODE=      # staging only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
