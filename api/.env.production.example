# Production variables for the `api` and `worker` Railway services (environment `production`).
# This file is a TEMPLATE: it is never read by the app. Set these in Railway → service → Variables → Raw Editor.
# Secrets stay empty here: generate them and keep them only in Railway.
# Not named `.env.production`: tools load that name automatically.

# ---- `api` service (root /api, config /api/railway.json) -------------------
NODE_ENV=production
APP_ENV=production              # never `local` on a deployed service
LOG_LEVEL=info
PORT=8080
APP_URL=https://web-production-94c552b4.up.railway.app   # public URL of the web service, no trailing slash
DATABASE_URL=${{Postgres.DATABASE_URL}}                   # Railway reference to the Postgres service
INTERNAL_API_TOKEN=             # 32+ chars, the SAME value as in web: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RESEND_API_KEY=                 # required outside local; without a real key no sign-in code or invite is sent
EMAIL_FROM=                     # e.g. SHARKX CRM <no-reply@your-verified-domain>
ALERT_EMAIL=                    # inbox for connection problems and errors (a real address)
# TOKEN_ENC_KEY=                # base64 32 bytes; needed from F5 (Meta tokens)

# ---- `worker` service (root /api, config /api/railway.worker.json) ---------
# Same code as the api, different start command. It needs only these:
#   NODE_ENV=production  APP_ENV=production  LOG_LEVEL=info
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   RESEND_API_KEY  EMAIL_FROM  ALERT_EMAIL      (the same three values as the api)
# It does NOT need PORT, APP_URL or INTERNAL_API_TOKEN.
